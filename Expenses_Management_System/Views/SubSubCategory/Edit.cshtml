@model Expenses_Management_System.Models.SubSubCategory

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Edit</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h4>sub_sub_category_tbl</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.sub_sub_catId)


    <div class="form-group">
        @Html.LabelFor(model => model.created_on, htmlAttributes: new { @class = "col-md-2 form-label font-weight-bold" }, labelText: "Category")
        <div class="col-md-10">
            @Html.DropDownList("cat_id", (SelectList)ViewBag.CAT, "Select Category", htmlAttributes: new { @class = "form-control" })
            @*@Html.ValidationMessageFor(model => model.sub_sub_catName, "", new { @class = "text-danger" })*@
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.created_on, htmlAttributes: new { @class = "col-md-2 form-label font-weight-bold" }, labelText: "Sub Category")
        <div class="col-md-10">
            @Html.DropDownList("subcat_id", (SelectList)ViewBag.SubCAT, "Select Sub Category", htmlAttributes: new { @class = "form-control" })
            @*@Html.ValidationMessageFor(model => model.sub_sub_catName, "", new { @class = "text-danger" })*@
        </div>
    </div>


    <div class="form-group">
        @Html.LabelFor(model => model.sub_sub_catName, htmlAttributes: new { @class = "col-md-2 form-label font-weight-bold" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.sub_sub_catName, new { htmlAttributes = new { @class = "form-control" } })
            @*@Html.ValidationMessageFor(model => model.sub_sub_catName, "", new { @class = "text-danger" })*@
        </div>
    </div>




    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Edit" class="btn btn-primary" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@model Expenses_Management_System.Models.expenses_tbl

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2 class="mb-4">Edit Expense</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="container">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.exp_id)

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.created_on, "Select Category", htmlAttributes: new { @class = "col-form-label" })
                    @Html.DropDownList("cat_id", (SelectList)ViewBag.CatMsg, "Select Category", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.created_on, "Select Sub Category", htmlAttributes: new { @class = "col-form-label" })
                    @Html.DropDownList("subcat_id", (SelectList)ViewBag.SubMsg, "Select Sub Category", new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.created_on, "Sub Sub Category", htmlAttributes: new { @class = "col-form-label" })
                    @Html.DropDownList("sub_sub_catId", (SelectList)ViewBag.SubSubMsg, "Select Sub Sub Category", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.item_name, htmlAttributes: new { @class = "col-form-label" })
                    @Html.EditorFor(model => model.item_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.item_qty, htmlAttributes: new { @class = "col-form-label" })
                    @Html.EditorFor(model => model.item_qty, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.total_price, htmlAttributes: new { @class = "col-form-label" })
                    @Html.EditorFor(model => model.total_price, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.remark, htmlAttributes: new { @class = "col-form-label" })
                    @Html.EditorFor(model => model.remark, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.sdate, htmlAttributes: new { @class = "col-form-label" })
                    @Html.EditorFor(model => model.sdate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                </div>
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Save</button>
            @Html.ActionLink("Back to List", "Index")
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

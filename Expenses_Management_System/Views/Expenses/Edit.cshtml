@model Expenses_Management_System.Models.expenses_tbl

@{
    ViewBag.Title = "Edit Expense";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2 class="mb-4">Edit Expense</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="container mt-4 p-4 border rounded">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.exp_id)

        <!-- Category and Subcategory Selection -->
        <div class="form-row">
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.category_tbl.cat_id, "Category", new { @class = "form-label font-weight-bold" })
                @Html.DropDownList("cat_id", (SelectList)ViewBag.CatMsg, "Select Category", new { @class = "form-control" })
            </div>
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.sub_category_tbl.subcat_id, "Sub Category", new { @class = "form-label font-weight-bold" })
                @Html.DropDownList("subcat_id", (SelectList)ViewBag.SubMsg, "Select Sub Category", new { @class = "form-control" })
            </div>
        </div>

        <!-- Sub Sub Category and Item Name -->
        <div class="form-row">
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.created_on, "Sub Sub Category", new { @class = "form-label font-weight-bold" })
                @Html.DropDownList("sub_sub_catId", (SelectList)ViewBag.SubSubMsg, "Select Sub Sub Category", new { @class = "form-control" })
            </div>
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.item_name, "Item Name", new { @class = "form-label font-weight-bold" })
                @Html.EditorFor(model => model.item_name, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <!-- Quantity and Total Price -->
        <div class="form-row">
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.item_qty, "Quantity", new { @class = "form-label font-weight-bold" })
                @Html.EditorFor(model => model.item_qty, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.total_price, "Total Price", new { @class = "form-label font-weight-bold" })
                @Html.EditorFor(model => model.total_price, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <!-- Remark and Date -->
        <div class="form-row">
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.remark, "Remark", new { @class = "form-label font-weight-bold" })
                @Html.EditorFor(model => model.remark, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="form-group col-md-6">
                @Html.LabelFor(model => model.sdate, "Date", new { @class = "form-label font-weight-bold" })
                @Html.EditorFor(model => model.sdate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="form-group text-center">
            <button type="submit" class="btn btn-primary">Save</button>
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ml-2" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

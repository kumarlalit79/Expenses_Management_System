@model Expenses_Management_System.Models.Expenses

@{
    ViewBag.Title = "Edit Expense";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Edit Expense</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.exp_id)

    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.cat_id, "Category")
                    @Html.DropDownListFor(model => model.cat_id, (SelectList)ViewBag.CatMsg, "Select Category", new { @class = "form-control", @id = "ddlcategory" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.sub_sub_catId, "Sub-Sub Category")
                    @Html.DropDownListFor(model => model.sub_sub_catId, (SelectList)ViewBag.SubSubMsg, "Select Sub Sub Category", new { @class = "form-control", @id = "ddlsubsubcategory" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.item_qty, "Qty")
                    @Html.EditorFor(model => model.item_qty, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.PaymentMode, "Payment Mode")
                    @Html.DropDownListFor(x => x.PaymentMode, (SelectList)ViewBag.paym, "Select Payment Mode", htmlAttributes: new { @class = "form-control", @id = "ddlPaymode" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.sdate, "Date")
                    @Html.TextBoxFor(model => model.sdate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.subcat_id, "Sub Category")
                    @Html.DropDownListFor(model => model.subcat_id, (SelectList)ViewBag.SubMsg, "Select Sub Category", new { @class = "form-control", @id = "ddlsubcategory" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.item_name, "Item Name")
                    @Html.EditorFor(model => model.item_name, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.total_price, "Price")
                    @Html.EditorFor(model => model.total_price, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.acid, "Select Bank")
                    @Html.DropDownListFor(x => x.acid, (SelectList)ViewBag.bank, "Select Bank", new { @class = "form-control", @id = "ddlBank" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.remark, "Remark")
                    @Html.EditorFor(model => model.remark, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    <div class="text-left">
                        <input type="submit" value="Save Changes" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>


@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script type="text/javascript">
    $(document).ready(function () {
        bindsub();
        bindBank();

        // Trigger the payment mode dropdown to load pre-selected bank data if needed
        $('#ddlPaymode').trigger('change');
    });


    function bindBank() {
        $('#ddlPaymode').change(function () {
            var payid = $(this).val();

            if (payid) {
                $.ajax({
                    url: '@Url.Action("GetBankEdit", "Expenses")',
                    type: 'GET',
                    data: { paymodeid: payid },
                    success: function (data) {
                        var bank = $('#ddlBank');
                        bank.empty();

                        // Add default 'Select Bank' option
                        bank.append($('<option></option>').val('').html('Select Bank'));

                        // Populate the bank dropdown with the returned data
                        for (var i = 0; i < data.length; i++) {
                            bank.append($('<option></option>').val(data[i].acid).html(data[i].bankname));
                        }

                        // Pre-select the bank from the model if available
                        var selectedBank = '@Model.acid';
                        if (selectedBank) {
                            bank.val(selectedBank);
                        } else {
                            //bank.val(''); // Default to 'Select Bank'
                        }
                    }
                });
            } else {
                $('#ddlBank').empty();
            }
        });
    }

    function bindsub() {
        $('#ddlcategory').change(function () {
            var catid = $(this).val();

            if (catid) {
                $.ajax({
                    url: '@Url.Action("GetSubcatEdit", "Expenses")',
                    type: 'GET',
                    data: { categoryid: catid },
                    success: function (data) {
                        var subcat = $('#ddlsubcategory');
                        subcat.empty();

                        var subsubcat = $('#ddlsubsubcategory');
                        subsubcat.empty();
                        subsubcat.append($('<option></option>').val('').html('Select SubSubcategory'));

                        // Populate the subcategory dropdown
                        subcat.append($('<option></option>').val('').html('Select Subcategory'));
                        for (var i = 0; i < data.length; i++) {
                            subcat.append($('<option></option>').val(data[i].subcat_id).html(data[i].subcat_name));
                        }
                    }
                });
            }
        });
    }
    </script>

    <script type="text/javascript">
    $(document).ready(function () {
        $('#ddlsubcategory').change(function () {
            var subcatid = $(this).val();
            var catid = $('#ddlcategory').val();

            if (subcatid) {
                $.ajax({
                    url: '@Url.Action("GetSubSubcatEdit", "Expenses")',
                    type: 'GET',
                    data: { subcategoryid: subcatid, categoryid: catid },
                    success: function (data) {
                        var subcat = $('#ddlsubsubcategory');
                        subcat.empty();
                        subcat.append($('<option></option>').val('').html('Select SubSubcategory'));

                        // Populate the sub-subcategory dropdown
                        for (var i = 0; i < data.length; i++) {
                            subcat.append($('<option></option>').val(data[i].sub_sub_catId).html(data[i].sub_sub_catName));
                        }
                    }
                });
            }
        });
    });
    </script>

}
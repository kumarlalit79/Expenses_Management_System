@model IEnumerable<Expenses_Management_System.Models.expenses_tbl>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>


<div class="col-md-4 ">
    <label for="Month">Select Month:</label> 
    @Html.DropDownList("monthno", (SelectList)ViewBag.Month, new { @class = "form-control mb-3", @id = "ddlMonth" })
</div>


<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        // Set the default value of the dropdown to the latest month
        $.ajax({
            url: '@Url.Action("GetLatestMonth", "Expenses")',
            type: 'GET',
            success: function (latestMonth) {
                $('#ddlMonth').val(latestMonth);

                // Trigger change event to load data for the latest month
                $('#ddlMonth').trigger('change');
            },
            error: function () {
                alert('Failed to retrieve latest month.');
            }
        });

        $('#ddlMonth').change(function () {
            var selectedMonth = $(this).val();

            $.ajax({
                url: '@Url.Action("Index", "Expenses")',
                type: 'GET',
                data: { monthno: selectedMonth },
                success: function (result) {
                    $('#expensesTable tbody').html($(result).find('#expensesTable tbody').html());
                },
                error: function () {
                    alert('Failed to retrieve data.');
                }
            });
        });
    });
</script>

@model IEnumerable<Expenses_Management_System.Models.expenses_tbl>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table table-bordered red-border text-center">
    <thead>
    <tr>
            <th>#</th>

            <th>Category </th>
            <th>Sub Category</th>
            <th>Sub-Sub Category </th>
            <th>Item_Name </th>
            <th>Qty</th>
            <th>Price</th>
        <th>Action</th>
    </tr>
    </thead>
    @{
        // Initialize the counter variable
        int itemCount = 0;
        foreach (var item in Model)
        {
            itemCount++;
    <tr>
        <td>
                @Html.DisplayFor(modelItem => itemCount)
        </td>

        <td>
            @Html.DisplayFor(modelItem => item.category_tbl.cat_name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.sub_category_tbl.subcat_name)
        </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.sub_sub_category_tbl.sub_sub_catName)
            </td>
        <td>
            @Html.DisplayFor(modelItem => item.item_name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.item_qty)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.total_price)
        </td>
            @*<td>
            @Html.DisplayFor(modelItem => item.remark)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.sdate)
        </td>*@
        @*<td>
            @Html.DisplayFor(modelItem => item.created_on)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.created_by)
        </td>*@


        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.exp_id }) |
            @Html.ActionLink("Details", "Details", new { id = item.exp_id }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.exp_id })
        </td>
    </tr>
}
        }

</table>

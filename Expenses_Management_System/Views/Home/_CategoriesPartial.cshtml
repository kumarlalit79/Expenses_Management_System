@model IEnumerable<Expenses_Management_System.Models.category_tbl>

<div style="display: flex; justify-content: space-between; align-items: center; padding: 10px;">
    <!-- Column for category checkboxes with border -->
    <div style="flex: 1; margin-right: 20px; border: 1px solid #ccc;  padding: 10px;">
        <h3>Select Categories</h3>
        <form id="categories-form">
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var category in Model)
                {
                    bool isDisabled = ViewBag.SelectedCategoryIds != null && ViewBag.SelectedCategoryIds.Contains(category.cat_id);
                    <li style="margin-bottom: 10px;">
                        <input type="checkbox" name="selectedCategories" value="@category.cat_id" @(isDisabled ? "disabled" : "") />
                        @category.cat_name
                    </li>
                }
            </ul>
        </form>
        <div>
            <button class="btn btn-primary" id="submit-categories">Save Categories</button>
        </div>
    </div>

    <!-- Centered button -->
    

    
</div>


@section Scripts {
    <script>
        $(document).on('click', '#submit-categories', function () {
            // Get all selected categories
            var selectedCategories = [];
            $('input[name="selectedCategories"]:checked:not(:disabled)').each(function () {
                selectedCategories.push($(this).val());
            });

            // Send selected categories to the server (via AJAX)
            $.ajax({
                url: '@Url.Action("SubmitCategories", "Home")',
                type: 'POST',
                data: { categories: selectedCategories },
                success: function (response) {
                    if (response.success) {
                        // Update the list of selected categories
                        var selectedCategoriesList = $('#selected-categories-list');
                        selectedCategoriesList.empty(); // Clear the existing list

                        $.each(response.selectedCategories, function (index, category) {
                            selectedCategoriesList.append('<li>' + category.cat_name + '</li>');
                        });

                        // Disable the checkboxes that are selected
                        $('input[name="selectedCategories"]:checked').attr('disabled', true);

                        alert('Categories saved successfully!');
                    } else {
                        alert('Error saving categories.');
                    }
                }
            });
        });
    </script>
}

@model IEnumerable<Expenses_Management_System.Models.category_tbl>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Category Details</h2>



<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table table-bordered red-border text-center">
    <thead>
        <tr>
            <th>#</th>
            <th>Category Name</th>

            <th>Action</th>
        </tr>
    </thead>
    

    @foreach (var item in Model)
    {
        <tbody>
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.cat_id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.cat_name)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.cat_id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.cat_id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.cat_id })
                </td>
            </tr>
            </tbody>
            }

    </table>

<p>
    @*@Html.ActionLink("User Details", "Index" , "User")
    @Html.ActionLink("Expenses", "Index" , "Expenses")*@
</p>
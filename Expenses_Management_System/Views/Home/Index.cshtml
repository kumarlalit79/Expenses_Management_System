@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load categories via AJAX when "Click here" or "Select more categories" link is clicked
            $('#choose-category-link, #choose-more-categories-link').click(function (e) {
                e.preventDefault(); // Prevent default action of the link

                // Show loading spinner or message if needed (optional)
                $('#category-selection-container').html('<p>Loading categories...</p>');

                // Load the partial view containing categories using AJAX
                $.ajax({
                    url: '@Url.Action("LoadCategories", "Home")',
                    type: 'GET',
                    success: function (data) {
                        // Inject the loaded partial view into the container
                        $('#category-selection-container').html(data).show();
                        $('#no-category-message').hide();  // Hide the message for new users
                        $('#user-selected-categories').hide();  // Hide selected categories for existing users
                    },
                    error: function () {
                        alert('Error loading categories.');
                    }
                });
            });

            // Handle form submission to save selected categories and update UI dynamically
            $(document).on('click', '#submit-categories', function () {
                // Get all selected categories
                var selectedCategories = [];
                $('input[name="selectedCategories"]:checked').each(function () {
                    selectedCategories.push($(this).val());
                });

                // Send selected categories to the server (via AJAX)
                $.ajax({
                    url: '@Url.Action("SubmitCategories", "Home")',
                    type: 'POST',
                    data: { categories: selectedCategories },
                    success: function (response) {
                        if (response.success) {
                            // Update the selected categories list dynamically after saving
                            var updatedCategoriesHtml = '';
                            $.each(response.selectedCategories, function (index, category) {
                                updatedCategoriesHtml += '<li>' + category.cat_name + '</li>';
                            });

                            // Display updated categories in the UI
                            $('#selected-category-list').html(updatedCategoriesHtml);
                            $('#user-selected-categories').show(); // Show the updated category list
                            $('#category-selection-container').hide(); // Hide the selection form

                            alert('Categories saved successfully!');
                        } else {
                            alert('Error saving categories.');
                        }
                    },
                    error: function () {
                        alert('Error saving categories.');
                    }
                });
            });
        });
    </script>

}
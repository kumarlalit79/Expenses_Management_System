@model Expenses_Management_System.Models.category_tbl

@{
    ViewBag.Title = "Category Details";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2 class="text-center mt-4">Category Details</h2>

<div class="card mt-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4>Details</h4>
    </div>
    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.cat_name)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.cat_name)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.created_on)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.created_on)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.created_by)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.created_by)
            </dd>

        </dl>
    </div>
    <div class="card-footer text-center">
        @Html.ActionLink("Edit", "Edit", new { id = Model.cat_id }, new { @class = "btn btn-primary mx-2" })
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary mx-2" })
    </div>
</div>

@model IEnumerable<Expenses_Management_System.Models.sub_category_tbl>

@{
    ViewBag.Title = "Subcategory Selection";
    Layout = "~/Views/Shared/Master.cshtml";
}


<p>
    @Html.ActionLink("Create New", "Create")
</p>

<div id="subcategory-section">
    <div id="user-selected-subcategories">
        <h3>Your Selected Subcategories:</h3>
        <table class="table table-bordered text-center" id="selected-subcategory-table" border="1">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Category Name</th>
                    <th>Subcategory Name</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.UserSelectedSubcategories != null)
                {
                    int i = 1;
                    foreach (var subcategory in ViewBag.UserSelectedSubcategories)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@subcategory.category_tbl.cat_name</td>
                            <td>@subcategory.subcat_name</td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
        <a href="#" id="choose-more-subcategories-link">Select more subcategories</a>
    </div>

    <div id="subcategory-selection-container" style="display:none;">
        <!-- Subcategories will be loaded here via AJAX -->
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#choose-more-subcategories-link').click(function (e) {
                e.preventDefault();

                $('#subcategory-selection-container').html('<p>Loading subcategories...</p>');

                $.ajax({
                    url: '@Url.Action("LoadSubcategories", "SubCategory")',
                    type: 'GET',
                    success: function (data) {
                        $('#subcategory-selection-container').html(data).show();
                        $('#user-selected-subcategories').hide();
                    },
                    error: function () {
                        alert('Error loading subcategories.');
                    }
                });
            });

            $(document).on('click', '#submit-subcategories', function () {
                var selectedSubcategories = [];
                $('input[name="selectedSubcategories"]:checked').each(function () {
                    selectedSubcategories.push($(this).val());
                });

                $.ajax({
                    url: '@Url.Action("SubmitSubcategories", "SubCategory")',
                    type: 'POST',
                    data: { subcategories: selectedSubcategories },
                    success: function (response) {
                        if (response.success) {
                            var updatedSubcategoriesHtml = '';
                            $.each(response.selectedSubcategories, function (index, subcategory) {
                                updatedSubcategoriesHtml += '<li>' + subcategory.subcat_name + '</li>';
                            });

                            $('#selected-subcategory-list').html(updatedSubcategoriesHtml);
                            $('#user-selected-subcategories').show();
                            $('#subcategory-selection-container').hide();

                            alert('Subcategories saved successfully!');
                        } else {
                            alert('Error saving subcategories.');
                        }
                    },
                    error: function () {
                        alert('Error saving subcategories.');
                    }
                });
            });
        });
    </script>
}

@model IEnumerable<Expenses_Management_System.Models.sub_category_tbl >


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Master.cshtml";
}

<h2>Sub Category Details</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table table-bordered red-border text-center">
    <thead>
        <tr>
            <th>#</th>
            <th>Category Name</th>
            <th>Sub Category Name</th>
            <th>Action</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.subcat_id)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.category_tbl.cat_name)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.subcat_name)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.subcat_id }) |
                @Html.ActionLink("Details", "Details", new { id = item.subcat_id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.subcat_id })
            </td>
        </tr>
    }

</table>

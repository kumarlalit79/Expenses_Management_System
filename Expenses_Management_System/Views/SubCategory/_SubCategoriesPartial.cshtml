@model IEnumerable<Expenses_Management_System.Models.sub_category_tbl>

<div style="border: 1px solid #ccc; margin-top: 10px; padding: 10px;">
    <h3>Select Subcategories</h3>
    <form id="subcategories-form">
        <ul style="list-style: none;">
            @foreach (var subcategory in Model)
            {
                bool isDisabled = ViewBag.SelectedSubcategoryIds != null && ViewBag.SelectedSubcategoryIds.Contains(subcategory.subcat_id);
                <li>
                    <input type="checkbox" name="selectedSubcategories" value="@subcategory.subcat_id" @(isDisabled ? "disabled" : "") />
                    @subcategory.subcat_name (@subcategory.category_tbl.cat_name)
                </li>
            }
        </ul>
    </form>
    <button id="submit-subcategories" class="btn btn-primary">Save Subcategories</button>
</div>
